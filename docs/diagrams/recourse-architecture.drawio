<mxfile host="app.diagrams.net" type="device">
  <diagram id="how-it-works" name="How it works">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="Recourse" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#161a25;" vertex="1" parent="1"><mxGeometry x="50" y="34" width="300" height="34" as="geometry"/></mxCell>
        <mxCell id="s1" value="A claim is&lt;br&gt;denied" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4429c4;strokeColor=#2f1b7a;fontSize=17;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="180" width="160" height="100" as="geometry"/></mxCell>
        <mxCell id="s2" value="Recourse reads the&lt;br&gt;denial's own code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cede;fontSize=17;fontColor=#161a25;arcSize=10;spacing=12;" vertex="1" parent="1"><mxGeometry x="270" y="175" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="s3" value="Paperwork,&lt;br&gt;or medicine?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efeaff;strokeColor=#4429c4;strokeWidth=2;fontSize=17;fontColor=#2f1b7a;arcSize=10;spacing=12;" vertex="1" parent="1"><mxGeometry x="540" y="185" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="o1" value="Paperwork — it drafts&lt;br&gt;the appeal for you" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eefaf3;strokeColor=#12734a;strokeWidth=2;fontSize=17;fontColor=#0d5c3a;arcSize=10;spacing=12;" vertex="1" parent="1"><mxGeometry x="780" y="90" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="o2" value="Medicine — only your&lt;br&gt;doctor can argue this" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efeaff;strokeColor=#4429c4;strokeWidth=2;fontSize=17;fontColor=#2f1b7a;arcSize=10;spacing=12;" vertex="1" parent="1"><mxGeometry x="780" y="190" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="o3" value="And it counts every&lt;br&gt;deadline, all the way down" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cede;fontSize=17;fontColor=#161a25;arcSize=10;spacing=12;" vertex="1" parent="1"><mxGeometry x="780" y="290" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="f" value="You have 180 days to appeal. The plan owes you an answer in 30 or 60. Nobody else is counting." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#5a6273;" vertex="1" parent="1"><mxGeometry x="50" y="420" width="1060" height="26" as="geometry"/></mxCell>
        <mxCell id="f2" value="It drafts. It never files, and it never goes quiet as a window closes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#5a6273;" vertex="1" parent="1"><mxGeometry x="50" y="448" width="1060" height="26" as="geometry"/></mxCell>
        <mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5a6273;strokeWidth=2;fontSize=14;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5a6273;strokeWidth=2;fontSize=14;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4429c4;strokeWidth=2;fontSize=14;fontColor=#4429c4;fontStyle=1;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="o1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4429c4;strokeWidth=2;fontSize=14;fontColor=#4429c4;fontStyle=1;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="o2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5a6273;strokeWidth=2;fontSize=14;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="o3"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="under-the-hood" name="Under the hood">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="One denied line, end to end" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#161a25;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="700" height="34" as="geometry"/></mxCell>
        <mxCell id="t2" value="The two interventions in the order they run, and the duty that fires when the agent is about to do nothing." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5a6273;" vertex="1" parent="1"><mxGeometry x="50" y="68" width="900" height="22" as="geometry"/></mxCell>
        <mxCell id="w1" value="A denied line&lt;br&gt;arrives" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4429c4;strokeColor=#2f1b7a;fontSize=11;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="195" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="w2" value="WATCH loop&lt;br&gt;reads the EOB and classifies each denial&lt;br&gt;from the X12 code the denial itself carries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cede;fontSize=11;fontColor=#161a25;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="270" y="180" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="w3" value="clerical&lt;br&gt;Recourse may prepare this one alone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efeaff;strokeColor=#4429c4;fontSize=11;fontColor=#2f1b7a;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="360" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="w4" value="clinical&lt;br&gt;handed straight back — no combination of&lt;br&gt;documents makes it yours" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeceb;strokeColor=#b42318;fontSize=11;fontColor=#912018;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="450" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="w5" value="unassessable&lt;br&gt;a code it cannot read is never “fine”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cede;fontSize=11;fontColor=#161a25;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="560" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="wa" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#5a6273;fontSize=10;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="w1" target="w2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="wb" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#4429c4;strokeWidth=2;fontSize=10;fontColor=#4429c4;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;fontStyle=1;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="w2" target="w3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="wc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#b42318;fontSize=10;fontColor=#b42318;endArrow=blockThin;endFill=1;dashed=1;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="w2" target="w4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="wd" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#5a6273;fontSize=10;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="w2" target="w5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m0" value="proposes&lt;br&gt;draft_appeal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efeaff;strokeColor=#4429c4;fontSize=11;fontColor=#2f1b7a;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="360" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="m1" value="1 · CitationGuard&lt;br&gt;does every clinical sentence cite a&lt;br&gt;document in this case file?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cede;fontSize=11;fontColor=#161a25;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="165" width="300" height="115" as="geometry"/></mxCell>
        <mxCell id="m1x" value="Deny&lt;br&gt;never reaches the world. There is nothing&lt;br&gt;here for a person to approve." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeceb;strokeColor=#b42318;fontSize=11;fontColor=#912018;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="1290" y="170" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="m2" value="2 · EscalationPolicy&lt;br&gt;may it act alone at this&lt;br&gt;autonomy level?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efeaff;strokeColor=#4429c4;fontSize=11;fontColor=#2f1b7a;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="340" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="m2x" value="Proceed&lt;br&gt;within limits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eefaf3;strokeColor=#12734a;fontSize=11;fontColor=#0d5c3a;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="1290" y="350" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="m3" value="Commit + journal entry&lt;br&gt;what it wrote · what it cited · who decided" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eefaf3;strokeColor=#12734a;fontSize=11;fontColor=#0d5c3a;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="1620" y="340" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="m4" value="Confirm&lt;br&gt;snapshot the run and stop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efeaff;strokeColor=#4429c4;fontSize=11;fontColor=#2f1b7a;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="510" width="300" height="85" as="geometry"/></mxCell>
        <mxCell id="m5" value="Decision inbox&lt;br&gt;the question, and the whole agent state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cede;fontSize=11;fontColor=#161a25;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="650" width="300" height="95" as="geometry"/></mxCell>
        <mxCell id="m6" value="You" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4429c4;strokeColor=#2f1b7a;fontSize=11;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="960" y="800" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="m7" value="Approve&lt;br&gt;the same run resumes, later,&lt;br&gt;on another machine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eefaf3;strokeColor=#12734a;fontSize=11;fontColor=#0d5c3a;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="1290" y="790" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="m8" value="Decline&lt;br&gt;nothing changes, and it is written&lt;br&gt;down that you refused" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeceb;strokeColor=#b42318;fontSize=11;fontColor=#912018;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="1290" y="930" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="ma" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#4429c4;strokeWidth=2;fontSize=10;fontColor=#4429c4;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="w3" target="m0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mb" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#4429c4;strokeWidth=2;fontSize=10;fontColor=#4429c4;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m0" target="m1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mc" value="Deny" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#b42318;fontSize=10;fontColor=#b42318;endArrow=blockThin;endFill=1;dashed=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m1" target="m1x"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="md" value="Proceed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#5a6273;fontSize=10;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m1" target="m2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me" value="no rule fires" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#5a6273;fontSize=10;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m2" target="m2x"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mf" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#5a6273;fontSize=10;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m2x" target="m3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mg" value="a rule fires" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#4429c4;strokeWidth=2;fontSize=10;fontColor=#4429c4;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m2" target="m4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mh" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#4429c4;strokeWidth=2;fontSize=10;fontColor=#4429c4;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m4" target="m5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mi" value="surfaced on Decisions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#5a6273;fontSize=10;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m5" target="m6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mj" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#4429c4;strokeWidth=2;fontSize=10;fontColor=#4429c4;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m6" target="m7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mk" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#b42318;fontSize=10;fontColor=#b42318;endArrow=blockThin;endFill=1;dashed=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m6" target="m8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ml" value="resumes the same run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#4429c4;strokeWidth=2;fontSize=10;fontColor=#4429c4;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;fontStyle=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="m7" target="m3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1" value="PRESS loop&lt;br&gt;runs on a schedule, not on a tool call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efeaff;strokeColor=#4429c4;fontSize=11;fontColor=#2f1b7a;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="1980" y="165" width="380" height="85" as="geometry"/></mxCell>
        <mxCell id="p2" value="policy.sweep.sweep()&lt;br&gt;over every open appeal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cede;fontSize=11;fontColor=#161a25;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="1980" y="285" width="380" height="70" as="geometry"/></mxCell>
        <mxCell id="p3" value="deadline_at_risk&lt;br&gt;your window is closing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cede;fontSize=11;fontColor=#161a25;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="1980" y="385" width="380" height="70" as="geometry"/></mxCell>
        <mxCell id="p4" value="insurer_overdue&lt;br&gt;the plan is late answering you" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cede;fontSize=11;fontColor=#161a25;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="1980" y="475" width="380" height="70" as="geometry"/></mxCell>
        <mxCell id="p5" value="unreadable&lt;br&gt;refuses that one appeal in words you can&lt;br&gt;act on, and carries on with the rest of the file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cede;fontSize=11;fontColor=#161a25;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="1980" y="565" width="380" height="95" as="geometry"/></mxCell>
        <mxCell id="pa" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#4429c4;strokeWidth=2;fontSize=10;fontColor=#4429c4;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pb" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#5a6273;fontSize=10;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#5a6273;fontSize=10;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pd" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#5a6273;fontSize=10;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n1" value="These three fire at every autonomy level, the most permissive included. Every other rule waits to be provoked by a tool call; this one fires because the agent is about to do nothing. A background agent that only spoke when provoked would go quiet through six months of a 180-day window and be right about everything except the thing that mattered." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5a6273;" vertex="1" parent="1"><mxGeometry x="1980" y="700" width="380" height="130" as="geometry"/></mxCell>
        <mxCell id="n2" value="Nothing is committed before the pause. A held decision leaves the journal empty for that step — it stopped before it did anything, not after." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5a6273;" vertex="1" parent="1"><mxGeometry x="1980" y="850" width="380" height="80" as="geometry"/></mxCell>
        <mxCell id="n3" value="Strands Agents on Amazon Bedrock. The model reasons; it never does the arithmetic. Every clock is a pure function over a notice date, a plan's rules and a stage." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5a6273;" vertex="1" parent="1"><mxGeometry x="1980" y="950" width="380" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
