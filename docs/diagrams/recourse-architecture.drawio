<mxfile host="app.diagrams.net" type="device">
  <diagram id="how-it-works" name="How it works">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="Recourse" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#161a25;" vertex="1" parent="1"><mxGeometry x="50" y="34" width="300" height="34" as="geometry"/></mxCell>
        <mxCell id="s1" value="A claim is&lt;br&gt;denied" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4429c4;strokeColor=#2f1b7a;fontSize=17;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="180" width="160" height="100" as="geometry"/></mxCell>
        <mxCell id="s2" value="Recourse reads the&lt;br&gt;denial's own code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cede;fontSize=17;fontColor=#161a25;arcSize=10;spacing=12;" vertex="1" parent="1"><mxGeometry x="270" y="175" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="s3" value="Paperwork,&lt;br&gt;or medicine?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efeaff;strokeColor=#4429c4;strokeWidth=2;fontSize=17;fontColor=#2f1b7a;arcSize=10;spacing=12;" vertex="1" parent="1"><mxGeometry x="540" y="185" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="o1" value="Paperwork — it drafts&lt;br&gt;the appeal for you" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eefaf3;strokeColor=#12734a;strokeWidth=2;fontSize=17;fontColor=#0d5c3a;arcSize=10;spacing=12;" vertex="1" parent="1"><mxGeometry x="780" y="90" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="o2" value="Medicine — only your&lt;br&gt;doctor can argue this" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efeaff;strokeColor=#4429c4;strokeWidth=2;fontSize=17;fontColor=#2f1b7a;arcSize=10;spacing=12;" vertex="1" parent="1"><mxGeometry x="780" y="190" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="o3" value="And it counts every&lt;br&gt;deadline, all the way down" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cede;fontSize=17;fontColor=#161a25;arcSize=10;spacing=12;" vertex="1" parent="1"><mxGeometry x="780" y="290" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="f" value="You have 180 days to appeal. The plan owes you an answer in 30 or 60. Nobody else is counting." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#5a6273;" vertex="1" parent="1"><mxGeometry x="50" y="420" width="1060" height="26" as="geometry"/></mxCell>
        <mxCell id="f2" value="It drafts. It never files, and it never goes quiet as a window closes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#5a6273;" vertex="1" parent="1"><mxGeometry x="50" y="448" width="1060" height="26" as="geometry"/></mxCell>
        <mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5a6273;strokeWidth=2;fontSize=14;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5a6273;strokeWidth=2;fontSize=14;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4429c4;strokeWidth=2;fontSize=14;fontColor=#4429c4;fontStyle=1;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="o1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4429c4;strokeWidth=2;fontSize=14;fontColor=#4429c4;fontStyle=1;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="o2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5a6273;strokeWidth=2;fontSize=14;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="o3"><mxGeometry relative="1" as="geometry"/></mxCell>
